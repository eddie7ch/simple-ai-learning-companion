# Copy this file to .env and add your Anthropic API key.
# Get a key at https://console.anthropic.com/
#
# NOTE: This simple version calls the Anthropic API directly from the
# browser using the "anthropic-dangerous-direct-browser-access" header.
# That means your API key is visible in the browser and NOT safe for a
# public/deployed app. It's fine for local development and learning.
# For production, move the API call to a small backend proxy instead.
VITE_ANTHROPIC_API_KEY=your-api-key-here
