# Copy this file to .env and add a Groq API key.
# Create one for free at https://console.groq.com/keys — no billing required.
#
# This key is read by the backend proxy (server/index.js) only — it is
# never sent to the browser, so it's safe even in a deployed app.
GROQ_API_KEY=your-groq-api-key-here

# Optional: port for the backend proxy server.
BACKEND_PORT=8787

# Optional: only needed if the frontend and backend run on different hosts
# (e.g. in production). Defaults to http://localhost:8787 for local dev.
VITE_BACKEND_URL=http://localhost:8787
